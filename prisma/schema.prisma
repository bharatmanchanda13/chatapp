// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  ALBUM
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum RelationshipStatus {
  SINGLE
  IN_A_RELATIONSHIP
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  FORGOT_PASSWORD
}

enum Platform {
  ANDROID
  IOS
  WEB
}

enum NotificationType {
  NEW_MATCH
  NEW_MESSAGE
  PROFILE_LIKE
  PROFILE_VIEW
  FRIEND_REQUEST
  CALL_MISSED
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum MediaOwnerType {
  PROFILE
  MESSAGE
  ALBUM
}

model User {
  id        Int      @id @default(autoincrement())

  name      String

  email     String?  @unique

  role      Role     @default(USER)

  phone     String?  @unique

  password  String

  deviceTokens DeviceToken[]

  isEmailVerified Boolean  @default(false)

  isPhoneVerified Boolean  @default(false)

  isActive  Boolean  @default(true)
  
  accessTokens String[] @default([])
  
  refreshTokens String[] @default([])

  profile Profile?
  
  sentFriendRequests FriendRequest[] @relation("SentFriendRequests")
  
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")

  friendshipsOne Friendship[] @relation("FriendshipsOne")

  friendshipsTwo Friendship[] @relation("FriendshipsTwo")

  conversations ConversationParticipant[]

  messages Message[]

  messageReads MessageRead[]

  media Media[]

  blockedUsers UserBlock[] @relation("UserBlocks")
  
  blockedBy    UserBlock[] @relation("BlockedByUsers")

  profileViewers ProfileView[] @relation("ProfileViewer")

  profileViewedBy ProfileView[] @relation("ProfileViewed")

  createdConversations Conversation[] @relation("ConversationCreator")

  notifications Notification[]

  albums Album[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model DeviceToken {
    id            String   @id @default(uuid())

    userId        Int
    user          User     @relation(fields: [userId], references: [id])

    fcmToken      String   @unique

    deviceId      String?
    platform      Platform

    isActive      Boolean  @default(true)

    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@index([userId])
}

model Profile {
  id Int @id @default(autoincrement())

  userId Int @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  gender Gender?

  dob DateTime?

  weight Float? // kg

  height Float? // cm

  bio String? @db.Text

  lookingFor String?

  latitude Float?

  longitude Float?

  relationshipStatus RelationshipStatus?

  interests String[] @default([])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserBlock {
  id Int @id @default(autoincrement())

  blockerId Int
  blockedId Int

  reason String?

  blocker User @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model OtpVerification {
  id         Int      @id @default(autoincrement())

  email      String?
  phone      String?

  otp        String
  purpose    OtpPurpose

  expiresAt  DateTime
  verifiedAt DateTime?

  createdAt  DateTime @default(now())

  @@index([email])
  @@index([phone])
  @@index([expiresAt])
}

model ProfileView {
  id         Int      @id @default(autoincrement())

  viewerId   Int
  profileId  Int

  viewer     User @relation("ProfileViewer", fields: [viewerId], references: [id])
  profile    User @relation("ProfileViewed", fields: [profileId], references: [id])

  createdAt  DateTime @default(now())

  @@index([profileId])
  @@index([viewerId])
}

model FriendRequest {
  id Int @id @default(autoincrement())

  senderId Int
  receiverId Int

  sender User @relation("SentFriendRequests", fields: [senderId], references: [id])

  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id])

  status FriendRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])

  @@index([senderId])
  @@index([receiverId])
}

model Friendship {
  id Int @id @default(autoincrement())

  userOneId Int
  userTwoId Int

  userOne User @relation("FriendshipsOne", fields: [userOneId], references: [id])

  userTwo User @relation("FriendshipsTwo", fields: [userTwoId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userOneId, userTwoId])

  @@index([userOneId])
  @@index([userTwoId])
}

model Conversation {
  id Int @id @default(autoincrement())

  type ConversationType

  name String?

  image String?

  participants ConversationParticipant[]

  messages Message[]

  createdById Int?

  createdBy User? @relation("ConversationCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model ConversationParticipant {
  id Int @id @default(autoincrement())

  conversationId Int

  userId Int

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  isAdmin Boolean @default(false)

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])

  @@index([conversationId])

  @@index([userId])
}

model Message {
  id Int @id @default(autoincrement())

  conversationId Int

  senderId Int

  content String?

  type MessageType @default(TEXT)

  albumId Int?
  album Album? @relation(fields: [albumId], references: [id])

  expiresAt DateTime?

  status MessageStatus @default(SENT)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id])

  reads MessageRead[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model MessageRead {
  id Int @id @default(autoincrement())

  messageId Int

  userId Int

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([messageId, userId])

  @@index([messageId])

  @@index([userId])
}

model Notification {
  id         String   @id @default(uuid())

  userId     Int
  user       User     @relation(fields: [userId], references: [id])

  title      String
  body       String

  type       NotificationType

  isRead     Boolean @default(false)

  metadata   Json?

  createdAt  DateTime @default(now())

  @@index([userId])
}

model Media {
  id          Int            @id @default(autoincrement())

  userId Int
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  ownerType   MediaOwnerType
  ownerId     Int

  type        MediaType

  storageKey  String
  url         String

  createdAt   DateTime @default(now())

  @@index([ownerType, ownerId])
}

model Album {
  id Int @id @default(autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id])

  title String?
  sharedMessages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}